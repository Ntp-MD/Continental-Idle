{
  "context_servers": {
    "local wright": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--viewport-size",
        "1900x900",
        "--allowed-origins",
        "http://127.0.0.1:5173;http://localhost:5173"
      ],
      "env": {}
    }
  }
}