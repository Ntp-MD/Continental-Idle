// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "outline_panel": {
    "button": false
  },
  "collaboration_panel": {
    "button": false
  },
  "git": {
    "show_stage_restore_buttons": false
  },
  "preferred_line_length": 200,
  "markdown_preview": {
    "max_width": 1000.0
  },
  "project_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "terminal": {
    "minimum_contrast": 45.0
  },
  "languages": {
    "HTML": {
      "format_on_save": "on"
    },
    "CSS": {
      "format_on_save": "on"
    }
  },
  "prettier": {
    "allowed": true
  },
  "proxy": "",
  "agent_servers": {
    "opencode": {
      "favorite_config_option_values": {
        "model": [
          "opencode/muse-spark-1.3-contributor-free",
          "cline-pass/cline-pass/deepseek-v4.1-flash",
          "cline-pass/cline-pass/glm-5.3-flash"
        ]
      },
      "default_config_options": {
        "effort": "high",
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "type": "registry"
    },
    "cline": {
      "default_config_options": {
        "auto_approve": true,
        "model": "cline-pass/glm-5.3-flash",
        "provider": "cline-pass"
      },
      "type": "registry"
    }
  },
  "session": {
    "trust_all_worktrees": true
  },
  "base_keymap": "VSCode",
  "icon_theme": "Zed (Default)",
  "ui_font_size": 16.0,
  "buffer_font_size": 12.0,
  "theme": "GitHub Dark",
