		        <script type="text/javascript">
        jQuery(document).ready(function($) {
            'use strict';
            
            if (!$('#phd-popup-overlay').length) {
                $('body').append('<div id="phd-popup-overlay"></div>');
            }
            
            var $overlay = $('#phd-popup-overlay');
            var currentImages = [];
            var currentIndex = 0;
            
            $(document).on('click', '#galeria a, .elementor-post.type-galeria a, .elementor-post.type-galeria, .galeria-item a, [data-post-type="galeria"] a', function(e) {
                var $target = $(this);
                var $link = $target.is('a') ? $target : $target.find('a').first();
                var href = $link.attr('href');
                
                if (!href || href.indexOf('/galeria/') === -1) {
                    return true;
                }
                
                e.preventDefault();
                e.stopPropagation();
                
                var postId = getPostIdFromLink($link);
                
                if (postId) {
                    openGaleriaPopup(postId);
                }
                
                return false;
            });
            
            function getPostIdFromLink($link) {
                var postId = $link.data('post-id');
                if (postId) return postId;
                
                postId = $link.closest('[data-post-id]').data('post-id');
                if (postId) return postId;
                
                var $card = $link.closest('.elementor-post');
                if ($card.length) {
                    var classes = $card.attr('class');
                    var match = classes.match(/post-(\d+)/);
                    if (match) return match[1];
                    
                    var cardId = $card.attr('id');
                    if (cardId) {
                        var idMatch = cardId.match(/post-(\d+)/);
                        if (idMatch) return idMatch[1];
                    }
                }
                
                var href = $link.attr('href');
                if (href) {
                    var urlMatch = href.match(/[?&]p=(\d+)/);
                    if (urlMatch) return urlMatch[1];
                }
                
                return null;
            }
            
            function openGaleriaPopup(postId) {
                $overlay.html('<div class="phd-loading"><div class="phd-spinner"></div><p>Carregando galeria...</p></div>');
                $overlay.css('display', 'flex').hide().fadeIn(300);
                $('body').css('overflow', 'hidden');
                
                $.ajax({
                    url: phdGaleriaPopup.ajaxurl,
                    type: 'POST',
                    data: {
                        action: 'phd_get_galeria_popup',
                        post_id: postId,
                        nonce: phdGaleriaPopup.nonce
                    },
                    success: function(response) {
                        if (response.success) {
                            $overlay.html(response.data.html);
                            initGallery();
                        } else {
                            $overlay.html('<div class="phd-error"><p>' + (response.data || 'Erro desconhecido') + '</p></div>');
                            setTimeout(closePopup, 3000);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Erro AJAX:', error);
                        $overlay.html('<div class="phd-error"><p>Erro ao carregar galeria. Tente novamente.</p></div>');
                        setTimeout(closePopup, 3000);
                    }
                });
            }
            
            function initGallery() {
                currentImages = [];
                
                $('.phd-main-image, .phd-galeria-thumb').each(function() {
                    var fullSrc = $(this).data('full');
                    if (fullSrc && currentImages.indexOf(fullSrc) === -1) {
                        currentImages.push(fullSrc);
                    }
                });
                
                $('.phd-main-image').on('click', function(e) {
                    e.stopPropagation();
                    var fullImg = $(this).data('full');
                    currentIndex = currentImages.indexOf(fullImg);
                    openLightbox(currentIndex);
                });
                
                $('.phd-galeria-thumb').on('click', function(e) {
                    e.stopPropagation();
                    var fullImg = $(this).data('full');
                    currentIndex = currentImages.indexOf(fullImg);
                    openLightbox(currentIndex);
                });
            }
            
            function openLightbox(index) {
                if (index < 0 || index >= currentImages.length) return;
                
                currentIndex = index;
                var $lightbox = $('#phd-lightbox');
                var $img = $lightbox.find('.phd-lightbox-image');
                
                $img.attr('src', currentImages[currentIndex]);
                $lightbox.fadeIn(300);
                
                $('.phd-lightbox-counter').text((currentIndex + 1) + ' / ' + currentImages.length);
                
                if (currentImages.length <= 1) {
                    $('.phd-lightbox-prev, .phd-lightbox-next').hide();
                } else {
                    $('.phd-lightbox-prev, .phd-lightbox-next').show();
                }
            }
            
            $(document).on('click', '.phd-lightbox-prev', function(e) {
                e.stopPropagation();
                currentIndex = (currentIndex - 1 + currentImages.length) % currentImages.length;
                openLightbox(currentIndex);
            });
            
            $(document).on('click', '.phd-lightbox-next', function(e) {
                e.stopPropagation();
                currentIndex = (currentIndex + 1) % currentImages.length;
                openLightbox(currentIndex);
            });
            
            $(document).on('click', '#phd-lightbox, .phd-lightbox-close', function(e) {
                if (e.target === this || $(e.target).hasClass('phd-lightbox-close')) {
                    $('#phd-lightbox').fadeOut(300);
                }
            });
            
            $(document).on('click', '#phd-popup-overlay, .phd-popup-close', function(e) {
                if (e.target === this || $(e.target).hasClass('phd-popup-close')) {
                    closePopup();
                }
            });
            
            function closePopup() {
                $overlay.fadeOut(300, function() {
                    $(this).empty();
                });
                $('body').css('overflow', '');
            }
            
            $(document).on('keyup', function(e) {
                if (e.key === 'Escape' || e.keyCode === 27) {
                    $('#phd-lightbox').fadeOut(300);
                    closePopup();
                }
            });
            
            $(document).on('keydown', function(e) {
                if ($('#phd-lightbox').is(':visible')) {
                    if (e.key === 'ArrowLeft' || e.keyCode === 37) {
                        $('.phd-lightbox-prev').click();
                    } else if (e.key === 'ArrowRight' || e.keyCode === 39) {
                        $('.phd-lightbox-next').click();
                    }
                }
            });
        });
        </script>
        		<script type="text/javascript">
		jQuery(document).ready(function($) {
			'use strict';

			// Cria overlay se ainda não existir
			if ( ! $('#phd-projetos-overlay').length ) {
				$('body').append('<div id="phd-projetos-overlay"></div>');
			}

			var $overlay = $('#phd-projetos-overlay');

			// -----------------------------------------------------------------
			// Intercepta cliques em links de projetos
			// Suporta: listagem nativa WP, Elementor Posts Widget e data-post-type
			// -----------------------------------------------------------------
			$(document).on(
				'click',
				'#projetos a, .elementor-post.type-projetos a, .elementor-post.type-projetos, [data-post-type="projetos"] a',
				function(e) {
					var $target = $(this);
					var $link   = $target.is('a') ? $target : $target.find('a').first();
					var href    = $link.attr('href') || '';

					// Só intercepta links que apontam para o CPT projetos
					if ( href.indexOf('/projetos/') === -1 ) {
						return true;
					}

					e.preventDefault();
					e.stopPropagation();

					var postId = getPostIdFromLink( $link );
					if ( postId ) {
						openProjetoPopup( postId );
					}

					return false;
				}
			);

			// -----------------------------------------------------------------
			// Extrai o post ID a partir do link ou do card do Elementor
			// -----------------------------------------------------------------
			function getPostIdFromLink( $link ) {
				// 1. Atributo data-post-id no próprio link
				var postId = $link.data('post-id');
				if ( postId ) return postId;

				// 2. Atributo data-post-id em um ancestral
				postId = $link.closest('[data-post-id]').data('post-id');
				if ( postId ) return postId;

				// 3. Classe post-{ID} no card do Elementor
				var $card = $link.closest('.elementor-post');
				if ( $card.length ) {
					var classes = $card.attr('class') || '';
					var match   = classes.match(/\bpost-(\d+)\b/);
					if ( match ) return match[1];

					var cardId  = $card.attr('id') || '';
					var idMatch = cardId.match(/post-(\d+)/);
					if ( idMatch ) return idMatch[1];
				}

				// 4. Query string ?p={ID}
				var urlMatch = href.match(/[?&]p=(\d+)/);
				if ( urlMatch ) return urlMatch[1];

				return null;
			}

			// -----------------------------------------------------------------
			// Abre o popup e faz a requisição AJAX
			// -----------------------------------------------------------------
			function openProjetoPopup( postId ) {
				$overlay
					.html('<div class="phd-loading"><div class="phd-spinner"></div><p>Carregando projeto...</p></div>')
					.css('display', 'flex')
					.hide()
					.fadeIn(300);

				$('body').css('overflow', 'hidden');

				$.ajax({
					url:  phdProjetosPopup.ajaxurl,
					type: 'POST',
					data: {
						action:  'phd_get_projetos_popup',
						post_id: postId,
						nonce:   phdProjetosPopup.nonce
					},
					success: function( response ) {
						if ( response.success ) {
							$overlay.html( response.data.html );
							initProjetoEvents();
						} else {
							var msg = response.data || 'Erro ao carregar o projeto.';
							$overlay.html('<div class="phd-error"><p>' + msg + '</p></div>');
							setTimeout( closePopup, 3000 );
						}
					},
					error: function() {
						$overlay.html('<div class="phd-error"><p>Erro de conexão. Tente novamente.</p></div>');
						setTimeout( closePopup, 3000 );
					}
				});
			}

			// -----------------------------------------------------------------
			// Inicializa eventos internos do popup
			// -----------------------------------------------------------------
			function initProjetoEvents() {
				// Clique na imagem destaque → abre lightbox
				$overlay.on('click', '.phd-main-image', function(e) {
					e.stopPropagation();
					var fullSrc = $(this).data('full');
					var alt     = $(this).attr('alt') || '';
					if ( fullSrc ) {
						openLightbox( fullSrc, alt );
					}
				});
			}

			// -----------------------------------------------------------------
			// Lightbox da imagem destaque
			// -----------------------------------------------------------------
			function openLightbox( src, alt ) {
				var $lb = $('#phd-lightbox');
				$lb.find('.phd-lightbox-image').attr({ src: src, alt: alt });
				$lb.fadeIn(300);
			}

			$(document).on('click', '#phd-lightbox, .phd-lightbox-close', function(e) {
				if ( e.target === this || $(e.target).hasClass('phd-lightbox-close') ) {
					$('#phd-lightbox').fadeOut(300);
				}
			});

			// -----------------------------------------------------------------
			// Fecha popup ao clicar no overlay ou no botão fechar
			// -----------------------------------------------------------------
			$(document).on('click', '#phd-projetos-overlay, .phd-popup-close', function(e) {
				if ( e.target === this || $(e.target).hasClass('phd-popup-close') ) {
					closePopup();
				}
			});

			function closePopup() {
				$('#phd-lightbox').hide();
				$overlay.fadeOut(300, function() {
					$(this).empty();
				});
				$('body').css('overflow', '');
			}

			// -----------------------------------------------------------------
			// Teclado: ESC fecha popup ou lightbox
			// -----------------------------------------------------------------
			$(document).on('keyup', function(e) {
				if ( e.key !== 'Escape' && e.keyCode !== 27 ) return;

				if ( $('#phd-lightbox').is(':visible') ) {
					$('#phd-lightbox').fadeOut(300);
				} else {
					closePopup();
				}
			});

		}); // end ready
		</script>
			</body>
</html>


