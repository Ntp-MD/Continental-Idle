{
  "name": "continental-idle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run clear-cache && vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:npc-engine": "tsx tests/test-npc-engine.ts",
    "test:npc-queue": "tsx tests/test-npc-queue.ts",
    "test:behavior": "tsx tests/audit-behavior.ts",
    "test:blueprint-schema": "tsx tests/test-blueprint-schema.ts",
    "test:wall-paint": "tsx tests/test-wall-paint.ts",
    "test:door-animation": "tsx tests/test-door-animation.ts",
    "test:door-passage-engine": "tsx tests/test-door-passage-engine.ts",
    "test:asset-schema": "tsx tests/test-asset-schema.ts",
    "test:sync-payload": "tsx tests/test-sync-payload.ts",
    "test:migrate": "tsx tests/test-migrate.ts",
    "test:npc-perf": "tsx tests/perf-npc-engine.ts",
    "test:npc-scale": "tsx tests/perf-npc-scale.ts",
    "test": "npm run test:npc-engine  &&  npm run test:npc-queue  &&  npm run test:blueprint-schema  &&  npm run test:wall-paint  &&  npm run test:door-animation  &&  npm run test:door-passage-engine  &&  npm run test:asset-schema  &&  npm run test:sync-payload  &&  npm run test:migrate  &&  npm run verify:assets",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run guard:data-restore && npm run test:unit && npm test",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"*.{ts,mjs,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"*.{ts,mjs,js,json}\"",
    "lint:bem": "node scripts/lint-bem.mjs",
    "clear-cache": "node -e \"const fs=require('fs');const p=require('path');const dir=p.join(process.cwd(),'node_modules','.tmp');if(fs.existsSync(dir)){fs.rmSync(dir,{recursive:true,force:true});console.log('[clear-cache] removed node_modules/.tmp')}else{console.log('[clear-cache] nothing to remove')};const vite=p.join(process.cwd(),'node_modules','.vite');if(fs.existsSync(vite)){fs.rmSync(vite,{recursive:true,force:true});console.log('[clear-cache] removed node_modules/.vite')}\"",
    "verify:assets": "node scripts/verify-assets.mjs",
    "guard:data-restore": "node scripts/guard-data-restore.mjs",
    "observe:hotel": "tsx scripts/observe-hotel.ts"
  },
  "dependencies": {
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.5"
  }
}
