{
  "name": "continental-idle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "clean": "node scripts/clean-artifacts.mjs",
    "clean:check": "node scripts/clean-artifacts.mjs --check",
    "test:behavior": "tsx tests/audit-behavior.ts",
    "test:npc-perf": "tsx tests/perf-npc-engine.ts",
    "test:npc-scale": "tsx tests/perf-npc-scale.ts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "verify": "npm run typecheck && npm run lint && npm run lint:bem && npm run lint:css && npm run test:unit && npm run verify:assets",
    "typecheck": "vue-tsc -p tsconfig.app.json && vue-tsc -p tsconfig.test.json && vue-tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "lint:bem": "node scripts/lint-bem.mjs",
    "lint:css": "node scripts/lint-css-compliance.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "observe:hotel": "tsx scripts/observe-hotel.ts"
  },
  "dependencies": {
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5"
  }
}
