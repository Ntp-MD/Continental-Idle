{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "blueprint-layout.v1.json",
  "type": "object",
  "required": ["version", "canvas", "floors"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "number" },
    "canvas": {
      "type": "object",
      "required": ["width", "height", "tileSize"],
      "properties": {
        "width": { "type": "number" },
        "height": { "type": "number" },
        "tileSize": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": true
    },
    "floors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "label", "objects"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "label": { "type": "string" },
          "objects": { "type": "array" },
          "defaultWalkable": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
