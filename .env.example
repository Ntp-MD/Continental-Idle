# Copy to .env.local to override. Both are build-time (Vite `import.meta.env`).

# Where the workspace is persisted: 'http' = a server endpoint (the Vite dev
# middleware writes src/blueprint-editor/data/blueprint-data.json),
# 'local' = this browser's IndexedDB. Unset -> http in dev, local in a build.
# VITE_PERSISTENCE=local

# Override the endpoint used by VITE_PERSISTENCE=http.
# VITE_BLUEPRINT_DATA_ENDPOINT=/__blueprint-data
